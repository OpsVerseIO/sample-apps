# Copy to .env and fill in. Read by both docker compose (collector) and Next.js.

# ---------------------------------------------------------------------------
# OTel Collector -> where telemetry goes
# ---------------------------------------------------------------------------

# ObserveNow (OTLP gRPC) — default exporter for all signals
UPSTREAM_OTLP_ENDPOINT=<observenow_collector_host>:443
UPSTREAM_AUTHORIZATION=Basic <base64(clientId:secret)>
UPSTREAM_OTLP_INSECURE=false

# ObserveNow backend whose collector is exposed over OTLP HTTP only (basic auth):
# UPSTREAM_OTLPHTTP_ENDPOINT=https://<observenow_otlp_http_host>
# UPSTREAM_AUTHORIZATION=Basic <base64(user:password)>
# TRACES_EXPORTERS=[otlphttp/upstream]
# LOGS_EXPORTERS=[otlphttp/upstream]
# METRICS_EXPORTERS=[otlphttp/upstream]

# Local LGTM stack instead (docker compose --profile local up):
# UPSTREAM_OTLP_ENDPOINT=lgtm:4317
# UPSTREAM_AUTHORIZATION=
# UPSTREAM_OTLP_INSECURE=true

# Per-signal exporter selection (YAML list). Options:
#   otlp/upstream, otlphttp/upstream, prometheusremotewrite/upstream (metrics only), debug
# TRACES_EXPORTERS=[otlp/upstream]
# LOGS_EXPORTERS=[otlp/upstream]
# METRICS_EXPORTERS=[otlp/upstream]
# UPSTREAM_OTLPHTTP_ENDPOINT=https://<host>
# UPSTREAM_PRW_ENDPOINT=https://<host>/api/v1/write

# Browser origins allowed to post to the Faro receiver (YAML list)
FARO_ALLOWED_ORIGINS=[http://localhost:3000]

# ---------------------------------------------------------------------------
# Next.js app -> local OTel Collector
# ---------------------------------------------------------------------------

# Server-side OTel SDK (OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=shop-server
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev

# Browser Faro SDK -> collector's faro receiver (must be reachable from the browser)
# Direct to an ObserveNow Faro endpoint (no local collector): https://<observenow_faro_host>/collect
NEXT_PUBLIC_FARO_COLLECTOR_URL=http://localhost:8027/collect
NEXT_PUBLIC_FARO_APP_NAME=shop-web
NEXT_PUBLIC_APP_ENV=dev

# Demo failure injection
PAYMENT_FAILURE_RATE=0.1
SLOW_PAYMENT_RATE=0.1

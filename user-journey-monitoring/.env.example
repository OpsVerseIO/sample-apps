# Copy to .env (read by both docker compose and Next.js) and pick one option.

# Option A: app -> local OTel Collector (docker compose up) -> ObserveNow
UPSTREAM_OTLP_ENDPOINT=https://<observenow_otlp_host>
UPSTREAM_AUTHORIZATION=Basic <base64(user:password)>
# Browser -> the collector's faro receiver (port 8027, see otel-collector/config.yaml
# and docker-compose.yaml). Must be reachable from users' browsers.
NEXT_PUBLIC_FARO_COLLECTOR_URL=http://localhost:8027/collect

# Option B: app -> ObserveNow directly (no local collector, no docker)
# NEXT_PUBLIC_FARO_COLLECTOR_URL=https://<observenow_faro_host>/collect
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<observenow_otlp_host>
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(user:password)>

      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "count by (session_id) (count_over_time({service_name=\"$app\"} | event_name=\"journey_step\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "B",

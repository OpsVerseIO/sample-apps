                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "session_id": "Session",
              "Value #A": "Journey events",
              "Value #B": "Failed steps",
              "Value #C": "Orders",
              "Value #D": "JS errors"
            }
          }
        }
      ]
